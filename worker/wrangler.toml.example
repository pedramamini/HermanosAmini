name = "sklz-presets"
main = "src/index.js"
compatibility_date = "2026-08-01"
workers_dev = true

# Optional: serve the admin dashboard from your own domain instead of the
# workers.dev URL. Only this prefix is routed to the Worker, so every other
# path on the zone still goes to your normal origin.
#
# Use TWO path segments. A bare /<code> is a bad idea for this project: the
# shipped .htaccess rewrites any 4-12 character base62 path to index.html as a
# share link, so a short admin code would be indistinguishable from a shared
# board and would burn a code out of that namespace.
#
# Needs a Cloudflare token with workers_routes:write and a PROXIED (orange
# cloud) DNS record for the hostname.
# routes = [
#   { pattern = "example.com/adm/*", zone_name = "example.com" },
#   # A signage domain whose ROOT is the demo, for players that accept a bare
#   # domain and nothing else. custom_domain lets Cloudflare provision and own
#   # the DNS record, so this needs workers_routes:write and NOT dns_records.
#   { pattern = "demo.example.com", custom_domain = true },
# ]

[[d1_databases]]
binding = "sklz_presets"
database_name = "sklz-presets"
database_id = "your-d1-database-id"

[vars]
# Required. The Worker refuses to serve on this placeholder. Generate your own:
#   openssl rand -hex 24
SALT = "change-me-any-random-string"
# The calavera\'s voice. "browser" = free speechSynthesis on the viewer\'s
# machine; "melotts" and "aura" render on Workers AI (see /api/tts). This is
# the kill switch: set "browser" and redeploy to stop spending neurons.
TTS_SOURCE = "aura2es"

[ai]
binding = "AI"
# Hidden admin dashboard at /adm/<ADMIN_TOKEN>. 20+ url-safe chars:
#   openssl rand -base64 36 | tr '+/' '-_' | tr -d '='
# Secret-link protection only; treat the URL as the password.
ADMIN_TOKEN = "change-me-openssl-rand-base64-36"
