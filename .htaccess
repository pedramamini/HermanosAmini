# hermanosamini.com, served by Apache from the shared dropbox DocumentRoot.
#
# This file is TRACKED and deployed by deploy.sh. It lived only on the server
# until 2026-08-18, which meant the canonical-host redirect existed nowhere in
# the repo and would have been lost silently by any host rebuild.

RewriteEngine On

# 1. Canonical host. This directory is served by BOTH vhosts (they share a
#    DocumentRoot), so the redirect MUST be conditional on hostname or
#    hermanosamini.com would redirect to itself forever.
RewriteCond %{HTTP_HOST} !^(www\.)?hermanosamini\.com$ [NC]
RewriteRule ^(.*)$ https://hermanosamini.com/$1 [R=301,L]

# 2. /demo -> the art, in demo mode, no gate. See the "demo path" block in
#    index.html.
#
#    The trailing-slash redirect is NOT cosmetic and must not be removed.
#    index.html loads version.json, the two audio files, gritos/*.mp3 and
#    qr.png by RELATIVE name. Under "/demo/" the browser resolves those
#    against /demo/ and every one of them 404s: no music, no gritos, no QR in
#    saved photos, and -- the expensive one -- checkVersion() can never see a
#    new build, so a wall display left on /demo/ would sit on a stale build
#    forever with nothing on screen to say so.
#
#    With no trailing slash the "directory" of /demo is /, so every relative
#    URL resolves exactly as it does at the root. So: send /demo/ to /demo,
#    then serve the real file without changing the address bar.
#    The scheme is spelled out. A bare "/demo" target made Apache build an
#    http:// Location, which cost a plaintext hop and a second redirect before
#    landing on https. Measured: 2 hops. Now it is 1.
RewriteRule ^demo/$ https://hermanosamini.com/demo [R=301,L]
RewriteRule ^demo$ index.html [L]

# 3. Short share links: hermanosamini.com/AbC123 -> the art, which resolves the
#    code against the Worker and applies that board. See "short code
#    resolution" in index.html.
#
#    THE TWO CONDITIONS ARE LOAD-BEARING. Without !-f and !-d this rule
#    swallows real files and directories: qr.png survives on its dot, but any
#    future extensionless file or a directory like /gritos would be served the
#    art instead of itself, and it would fail silently in exactly the way
#    nobody notices until a wall display has been wrong for a month.
#
#    Same no-trailing-slash reasoning as /demo above: relative assets must
#    resolve against /, so /AbC123/ is sent to /AbC123 first. The scheme is
#    spelled out so it is one https hop, not an http hop and then a redirect.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9]{4,12})/$ https://hermanosamini.com/$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9]{4,12})$ index.html [L]
